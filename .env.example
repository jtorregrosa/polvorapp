# Local development only (ADR-0006). Copy to .env: `cp .env.example .env`.
# Placeholders are not secrets (loopback-only services); change them if you like. Real
# environments get their values from the host's secret store.
# Never commit .env.

ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL (db)
POSTGRES_DB=polvorapp
POSTGRES_USER=polvorapp
POSTGRES_PASSWORD=local-only-change-me

# Object storage (storage, MinIO). Used from add-arquebusier-photos.
MINIO_ROOT_USER=polvorapp
MINIO_ROOT_PASSWORD=local-only-change-me

# Host ports (change them if the defaults are taken on your machine)
WEB_PORT=8080
DB_PORT=5432

# Build metadata shown in the UI footer
APP_VERSION=0.1.0-local
GIT_COMMIT=local
