# Local development only (ADR-0006). Copy to .env: `cp .env.example .env`.
# Placeholders are not secrets (loopback-only services); change them if you like. Real
# environments get their values from the host's secret store.
# Never commit .env.

ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL (db)
POSTGRES_DB=polvorapp
POSTGRES_USER=polvorapp
POSTGRES_PASSWORD=local-only-change-me

# Object storage (storage, MinIO): private bucket for arquebusier photos (ADR-0005). The local API
# signs in with the root credentials; real environments use a key limited to the bucket.
# MinIO console: http://localhost:9001
MINIO_ROOT_USER=polvorapp
MINIO_ROOT_PASSWORD=local-only-change-me
STORAGE_BUCKET=polvorapp-photos

# Transactional email (local: delivered to Mailpit, http://localhost:8025)
EMAIL_FROM=no-reply@polvorapp.example

# Synthetic users created by `docker compose run --rm api-seed` (SEC-11): every active user signs
# in with this password and this authenticator key (Base32; add it to an authenticator app, or
# compute codes in tests). These published values only work in Development; Staging must use
# secret values of its own.
SEED_USER_PASSWORD=local-only-seed-password
SEED_AUTHENTICATOR_KEY=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP

# What `docker compose run --rm api-seed` creates: Full (four scenario comparsas plus sixteen more,
# about 450 arquebusiers with faces and specimen license photos, and their orders; about a minute) or
# Scenarios (the small fixed cases the automated tests and CI use). Reset the database
# (`docker compose down -v`) before switching from Full to Scenarios.
SEED_DATASET=Full

# Sign-in rate limits per client address (defaults 10 per minute and 5 emails per 15 minutes).
# The E2E suite signs in many times from one address: raise them to run it, e.g. 300 and 100.
# RATE_LIMIT_AUTH_PER_MINUTE=10
# RATE_LIMIT_AUTH_EMAIL_PER_15_MINUTES=5
# Registry and photo writes per user and minute (default 60); the E2E suite needs more, e.g. 600.
# RATE_LIMIT_PERSONAL_DATA_WRITES_PER_MINUTE=60
# Image uploads the server decodes (comparsa logos) per user and minute (default 20); E2E, e.g. 200.
# RATE_LIMIT_IMAGE_UPLOADS_PER_MINUTE=20
# Spreadsheet imports the server reads (arquebusier import check and import) per user and minute
# (default 10); E2E, e.g. 100.
# RATE_LIMIT_SPREADSHEET_IMPORTS_PER_MINUTE=10
# Comparsa order writes (entries, loans, submission, review) per user and minute (default 120).
# RATE_LIMIT_ORDER_WRITES_PER_MINUTE=120
# Export downloads (Excel and PDF) per user and minute (default 30); E2E, e.g. 300.
# RATE_LIMIT_EXPORTS_PER_MINUTE=30
# GDPR lookups, exports and erasures per user and minute (default 10); E2E, e.g. 100.
# RATE_LIMIT_PRIVACY_PER_MINUTE=10
# How often the API sends notification emails, in seconds (add-notifications).
# NOTIFICATIONS_DISPATCH_INTERVAL_SECONDS=30

# Host ports (change them if the defaults are taken on your machine)
WEB_PORT=8080
DB_PORT=5432

# Build metadata shown in the UI footer
APP_VERSION=0.1.0-local
GIT_COMMIT=local
