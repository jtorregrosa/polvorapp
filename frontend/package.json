{
  "name": "polvorapp-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "generate:api": "orval --config orval.config.ts",
    "predev": "npm run generate:api",
    "dev": "vite",
    "prebuild": "npm run generate:api",
    "build": "tsc -b && vite build",
    "pretypecheck": "npm run generate:api",
    "typecheck": "tsc -b --noEmit",
    "prelint": "npm run generate:api",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-i18n": "node scripts/check-i18n.mjs src/i18n/locales",
    "pretest": "npm run generate:api",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:coverage": "npm run generate:api",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.0",
    "i18next": "26.4.2",
    "i18next-browser-languagedetector": "8.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "1.0.4",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "msw": "3.0.0",
    "orval": "8.38.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.2"
  },
  "overrides": {
    "@scalar/json-magic": {
      "undici": "7.30.0"
    }
  }
}
