{
  "$comment": "Synthetic DNI/NIE cases (BR-01, change add-arquebusier-registry, design D4). Read by the backend xUnit tests and the frontend Vitest tests so both validators stay identical. Each case has either 'normalized' (accepted value) or 'error' ('required', 'invalid', 'checkLetter').",
  "cases": [
    {"name": "DNI", "input": "12345678Z", "normalized": "12345678Z"},
    {"name": "DNI with leading zeros", "input": "00000000T", "normalized": "00000000T"},
    {"name": "DNI with the highest number", "input": "99999999R", "normalized": "99999999R"},
    {"name": "NIE with X", "input": "X1234567L", "normalized": "X1234567L"},
    {"name": "NIE with Y", "input": "Y1234567X", "normalized": "Y1234567X"},
    {"name": "NIE with Z", "input": "Z1234567R", "normalized": "Z1234567R"},
    {"name": "lower case, surrounding spaces and hyphen", "input": " 12345678-z ", "normalized": "12345678Z"},
    {"name": "inner spaces", "input": "12 345 678 z", "normalized": "12345678Z"},
    {"name": "NIE in lower case with hyphens", "input": "x-1234567-l", "normalized": "X1234567L"},
    {"name": "tab", "input": "12345678\tZ", "normalized": "12345678Z"},
    {"name": "empty", "input": "", "error": "required"},
    {"name": "only spaces and hyphens", "input": " - ", "error": "required"},
    {"name": "wrong DNI letter", "input": "12345678A", "error": "checkLetter"},
    {"name": "wrong NIE letter", "input": "X1234567A", "error": "checkLetter"},
    {"name": "seven digits", "input": "1234567Z", "error": "invalid"},
    {"name": "nine digits", "input": "123456789Z", "error": "invalid"},
    {"name": "no letter", "input": "12345678", "error": "invalid"},
    {"name": "two letters", "input": "12345678ZZ", "error": "invalid"},
    {"name": "unknown NIE prefix", "input": "W1234567L", "error": "invalid"},
    {"name": "dots", "input": "12.345.678-Z", "error": "invalid"},
    {"name": "Cyrillic Ha instead of X", "input": "\u04251234567L", "error": "invalid"},
    {"name": "Greek Upsilon instead of Y", "input": "\u03A51234567X", "error": "invalid"},
    {"name": "full-width digits", "input": "\uFF11\uFF12\uFF13\uFF14\uFF15\uFF16\uFF17\uFF18Z", "error": "invalid"},
    {"name": "no-break space", "input": "12345678\u00A0Z", "error": "invalid"},
    {"name": "accented letter", "input": "12345678\u00C9", "error": "invalid"},
    {"name": "line feed", "input": "12345678\nZ", "error": "invalid"},
    {"name": "em space", "input": "12345678\u2003Z", "error": "invalid"},
    {"name": "Unicode hyphen", "input": "12345678\u2010Z", "error": "invalid"},
    {"name": "minus sign", "input": "12345678\u2212Z", "error": "invalid"},
    {"name": "long s that JavaScript upper-cases to S", "input": "12345678\u017F", "error": "invalid"},
    {"name": "dotless i that JavaScript upper-cases to I", "input": "12345678\u0131", "error": "invalid"},
    {"name": "Cyrillic Ze as check letter", "input": "12345678\u0417", "error": "invalid"},
    {"name": "full-width check letter", "input": "12345678\uFF3A", "error": "invalid"},
    {"name": "emoji (surrogate pair)", "input": "12345678\uD83D\uDE00", "error": "invalid"},
    {"name": "NUL character", "input": "12345678\u0000Z", "error": "invalid"},
    {"name": "lower-case NIE prefix with wrong letter", "input": "x1234567a", "error": "checkLetter"},
    {"name": "longer than 64 characters", "input": "11111111111111111111111111111111111111111111111111111111111111111Z", "error": "invalid"}
  ]
}
