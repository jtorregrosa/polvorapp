    <EmbeddedResource Include="Fonts\Geist-Regular.ttf" LogicalName="PolvorApp.Exports.Fonts.Geist-Regular.ttf" />
    <EmbeddedResource Include="Fonts\Geist-Bold.ttf" LogicalName="PolvorApp.Exports.Fonts.Geist-Bold.ttf" />
    <None Update="Fonts\Geist-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

