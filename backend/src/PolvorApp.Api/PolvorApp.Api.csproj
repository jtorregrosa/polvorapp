<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>PolvorApp.Api</RootNamespace>
    <NeutralLanguage>es-ES</NeutralLanguage>

    <!-- Committed API contract (spec: Generated API contract). Docker builds pass -p:OpenApiGenerateDocuments=false. -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../../contracts</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PolvorApp.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Modules\ArquebusierRegistry\PolvorApp.ArquebusierRegistry\PolvorApp.ArquebusierRegistry.csproj" />
    <ProjectReference Include="..\Modules\AuditPrivacy\PolvorApp.AuditPrivacy\PolvorApp.AuditPrivacy.csproj" />
    <ProjectReference Include="..\Modules\FederationCatalog\PolvorApp.FederationCatalog\PolvorApp.FederationCatalog.csproj" />
    <ProjectReference Include="..\Modules\IdentityAccess\PolvorApp.IdentityAccess\PolvorApp.IdentityAccess.csproj" />
    <ProjectReference Include="..\PolvorApp.SharedKernel\PolvorApp.SharedKernel.csproj" />
  </ItemGroup>

</Project>
