# Source spreadsheets and PDFs contain real personal data (DNI, phones, emails).
# Never commit them. Only the questionnaire answers are tracked.
docs/sources/*
!docs/sources/answers.md

# Local environment (secrets). Only .env.example is committed.
.env
.env.*
!.env.example

# .NET build output
bin/
obj/
TestResults/
publish/
*.log
*.suo
*.user
.vs/

# Node / frontend
node_modules/
dist/
dev-dist/
coverage/
frontend/src/api/generated/
playwright-report/
test-results/
# Playwright sessions of the seeded E2E users
frontend/e2e/.auth/
blob-report/
.vite/

# IDE / OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
frontend/src/features/__lint_probe_*/
frontend/src/components/app/__lint_probe_*/
storybook-static/

# Python caches (skill scripts)
__pycache__/
*.pyc

# Raw outputs of scripts/generate-seed-images.mjs, cached so a rerun never pays twice; the optimised
# images are committed in backend/synthetic-data (realistic-seed-data, design D5).
seed-assets/
